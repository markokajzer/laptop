#!/bin/bash

nl_echo() {
  local fmt="$1"; shift
  printf "\n$fmt\n" "$@"
}

export HOMEBREW_NO_INSTALL_CLEANUP=1

LAPTOP_FOLDER="$HOME/laptop-init"
WALLPAPER_URL="https://w.wallhaven.cc/full/x1/wallhaven-x1rowv.jpg"


# Ask for the administrator password upfront
sudo -v

mkdir -p ~/projects

nl_echo "Installing Command Line Tools..."
xcode-select --install

nl_echo "Cloning laptop..."
cd ~/projects || exit 1
rm -rf "$LAPTOP_FOLDER"
git clone --quiet https://github.com/markokajzer/laptop.git "$LAPTOP_FOLDER"

if ! command -v brew >/dev/null; then
  nl_echo "Installing Brew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  echo -n "Loading Brew..."
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
else
  nl_echo "Updating Brew..."
  brew update
fi


nl_echo "Installing fonts..."
brew install --quiet --yes \
  font-fira-mono \
  font-inconsolata-dz-for-powerline


nl_echo "Installing Brew packages..."
packages=(
  autoconf
  automake
  dockutil
  gh
  git
  mas
  mise
  openssl
  PeonPing/tap/peon-ping
  smudge/smudge/nightlight
  sqlite
  zsh
)
brew install --quiet --yes "${packages[@]}"

echo "Installing Applications..."
applications=(
  1password
  ausweisapp
  chatgpt
  claude
  codexbar
  github
  google-chrome
  spotify
  visual-studio-code
)
brew install --cask --quiet --yes --adopt "${applications[@]}"

# Install applications from the Mac App Store
app_store_applications=(
  1545870783 # System Color Picker
)
mas get "${app_store_applications[@]}"

# Install apps from GitHub
github_apps=(
  "AudioPriorityBar=tobi/AudioPriorityBar"
)

for github_app in "${github_apps[@]}"; do
  github_app_name="${github_app%%=*}"
  github_app_repo="${github_app#*=}"
  github_app_archive="$(mktemp -t "$github_app_name")"
  curl -fsSL "https://github.com/$github_app_repo/releases/latest/download/$github_app_name.zip" \
    -o "$github_app_archive"
  ditto -x -k "$github_app_archive" /Applications
  rm "$github_app_archive"
done


echo
printf "Do we need Ruby? [yN]  "
read -r response
if [[ "$response" = "y" ]]; then
  echo "Creating .gemrc..."
  echo "gem: --no-document" >| ~/.gemrc

  echo "Installing latest stable Ruby..."
  ruby_version="$(mise ls-remote ruby | grep -E '^\d+\.\d+\.\d+$' | tail -1)"
  mise use -g ruby@"$ruby_version"

  echo "Updating RubyGems and installing bundler..."
  gem update --system
  gem install bundler
else
  echo "Skipping Ruby."
fi

echo
printf "Do we need Python? [yN]  "
read -r response
if [[ "$response" = "y" ]]; then
  echo "Installing latest stable Python..."
  python_version="$(mise ls-remote python | grep -E '^\d+\.\d+\.\d+$' | tail -1)"
  mise use -g python@"$python_version"

  echo "Updating pip..."
  pip install --upgrade pip
else
  echo "Skipping Python."
fi



if [[ ! -d ~/.zprezto ]]; then
  nl_echo "Installing prezto..."
  git clone --recursive https://github.com/sorin-ionescu/prezto.git "${ZDOTDIR:-$HOME}/.zprezto"
  ln -s ~/.zprezto/runcoms/zlogin    ~/.zlogin
  ln -s ~/.zprezto/runcoms/zlogout   ~/.zlogout
  ln -s ~/.zprezto/runcoms/zpreztorc ~/.zpreztorc
  ln -s ~/.zprezto/runcoms/zprofile  ~/.zprofile
  ln -s ~/.zprezto/runcoms/zshenv    ~/.zshenv
  ln -s ~/.zprezto/runcoms/zshrc     ~/.zshrc
else
  nl_echo "prezto is already installed."
fi

nl_echo "Cleaning up Brew..."
brew cleanup --quiet --scrub
unset HOMEBREW_NO_INSTALL_CLEANUP

nl_echo "Copying configuration files..."
(
  cd "$LAPTOP_FOLDER" || exit 1
  ./bin/copy_files_to_machine
)

if [[ -f ~/.ssh/id_rsa ]]; then
  nl_echo "SSH key already exists."
  echo "Run 'pbcopy < ~/.ssh/id_rsa.pub' and paste into GitHub"
else
  nl_echo "Generating RSA token for GitHub..."
  mkdir -p ~/.ssh
  touch ~/.ssh/config
  ssh-keygen -t rsa -b 4096 -C "markokajzer91@gmail.com"
  echo "Host *\n AddKeysToAgent yes\n UseKeychain yes\n IdentityFile ~/.ssh/id_rsa" | tee ~/.ssh/config
  eval "$(ssh-agent -s)"
  echo "Run 'pbcopy < ~/.ssh/id_rsa.pub' and paste into GitHub"
fi

nl_echo "Changing shell to zsh..."
chsh -s /bin/zsh


nl_echo "Changing settings..."

###############################################################################
# General UI/UX                                                               #
###############################################################################

# Disable automatic capitalization after period
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false

# Disable automatic period substitution when hitting space twice
defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false

# Disable auto-correct
defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false


###############################################################################
# Night Shift                                                                 #
###############################################################################

# sunset to sunrise, very warm
nightlight schedule start
nightlight temp 90
nightlight on


###############################################################################
# Keyboard                                                                    #
###############################################################################

# Enable press-and-hold for keys instead of key repeat
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool true

# Set super fast key repeat
# KeyRepeat values: 120, 90, 60, 30, 12, 6, 2 (smaller = faster)
defaults write NSGlobalDomain KeyRepeat -int 2
# InitialKeyRepeat: 120, 94, 68, 35, 25, 15
defaults write NSGlobalDomain InitialKeyRepeat -int 15


###############################################################################
# Finder                                                                      #
###############################################################################

# Finder: show all filename extensions
defaults write NSGlobalDomain AppleShowAllExtensions -bool true

# Enable snap-to-grid for icons on the desktop and in other icon views
/usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:arrangeBy grid" ~/Library/Preferences/com.apple.finder.plist
/usr/libexec/PlistBuddy -c "Set :FK_StandardViewSettings:IconViewSettings:arrangeBy grid" ~/Library/Preferences/com.apple.finder.plist
/usr/libexec/PlistBuddy -c "Set :StandardViewSettings:IconViewSettings:arrangeBy grid" ~/Library/Preferences/com.apple.finder.plist

# Finder: show the sidebar by default
defaults write com.apple.finder ShowSidebar -bool true

# Avoid .DS_Store files on shared and external volumes
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# Do not hide Library folder
chflags nohidden ~/Library


###############################################################################
# Menu bar                                                                    #
###############################################################################

# Show Bluetooth in the menu bar
defaults write com.apple.controlcenter "NSStatusItem Visible Bluetooth" -bool true

# Set menu bar item order from left to right:
# Input Source, Bluetooth, Wi-Fi, Battery, Spotlight, Control Center
# Preferred positions are pixel offsets from the right side of the menu bar.
defaults write com.apple.TextInputMenuAgent "NSStatusItem Preferred Position Item-0" -int 314
defaults write com.apple.controlcenter "NSStatusItem Preferred Position Bluetooth" -int 282
defaults write com.apple.controlcenter "NSStatusItem Preferred Position WiFi" -int 244
defaults write com.apple.controlcenter "NSStatusItem Preferred Position Battery" -int 202
defaults write com.apple.Spotlight "NSStatusItem Preferred Position Item-0" -int 171
# defaults write com.apple.controlcenter "NSStatusItem Preferred Position BentoBox-0" -int 129


###############################################################################
# Dock and hot corners                                                        #
###############################################################################

# Automatically hide and show the Dock
defaults write com.apple.dock autohide -bool true

# Set Dock icon size
defaults write com.apple.dock tilesize -int 48

# Show pinned and open applications in the Dock
defaults write com.apple.dock static-only -bool false

# Hide suggested and recent apps in the Dock
defaults write com.apple.dock show-recents -bool false

# Set pinned Dock applications (Finder is always first)
dockutil --remove all \
  --add "/System/Applications/Utilities/Terminal.app" \
  --add "/Applications/Visual Studio Code.app" \
  --add "/Applications/Google Chrome.app" \
  --no-restart > /dev/null

# Do not re-arrange spaces based on recent use
defaults write com.apple.dock mru-spaces -bool false

# Set Active Edges
# None = 1, Mission Control = 2, Application Windows = 3, Desktop = 4, Screen Saver = 5
# Disable Screen Saver = 6, Dashboard = 7, Sleep Mode = 10, Launchpad = 11, Notification Center = 12
# defaults write com.apple.dock wvous-bl-corner -int 3
defaults write com.apple.dock wvous-br-corner -int 4


###############################################################################
# Terminal                                                                    #
###############################################################################

# Disable Terminal markers
defaults write com.apple.Terminal AutoMarkPromptLines -bool false

# Enable Secure Keyboard Entry in Terminal.app
# See: https://security.stackexchange.com/a/47786/8918
defaults write com.apple.Terminal SecureKeyboardEntry -bool true


###############################################################################
# Touch Bar                                                                   #
###############################################################################

# Always show expanded control strip on Touchbar
# defaults write com.apple.touchbar.agent PresentationModeGlobal fullControlStrip


nl_echo "Setting Terminal profiles..."
terminal_preferences="$(mktemp)"
defaults export com.apple.Terminal "$terminal_preferences" >/dev/null
for terminal_profile in "$LAPTOP_FOLDER"/files/terminal/*.terminal; do
  terminal_profile_name="$(basename "$terminal_profile" .terminal)"
  terminal_profile_xml="$(plutil -convert xml1 -o - "$terminal_profile")"
  plutil -replace "Window Settings.$terminal_profile_name" \
    -xml "$terminal_profile_xml" "$terminal_preferences"
done
plutil -replace "Default Window Settings" -string "Solarized Dark" "$terminal_preferences"
plutil -replace "Startup Window Settings" -string "Solarized Dark" "$terminal_preferences"
defaults import com.apple.Terminal "$terminal_preferences"
rm "$terminal_preferences"


nl_echo "Changing desktop wallpaper..."
curl -o $LAPTOP_FOLDER/files/wallpaper.jpg $WALLPAPER_URL
osascript -e "tell application \"system events\" to set picture of every desktop to (\"$LAPTOP_FOLDER/files/wallpaper.jpg\" as posix file as alias)"


nl_echo "Restarting affected applications..."
killall ControlCenter TextInputMenuAgent Spotlight ControlStrip Dock cfprefsd Finder


nl_echo "Yuhu! Installation completed."
echo "Terminal profile will update on Terminal restart"
echo "Things left to do:"
echo "[ ] Setup 1Password"
